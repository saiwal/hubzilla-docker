# ==========================================
# Repo setup
# ==========================================
# Hubzilla core repository.
HZ_REPO=https://framagit.org/hubzilla/core.git
# Branch to track (master, dev) or a release tag to pin to (e.g. 9.4.4).
HUBZILLA_VERSION=master

# Addon/theme repos: comma-separated list of "<url> <name> [tag]" entries.
# The optional tag pins that repo to a release tag (pinned repos stop auto-updating).
# New entries are added on next restart; unpinned ones are updated on every restart.
# e.g. ADDON_REPOS=https://framagit.org/hubzilla/addons.git addons-official 9.4.4, https://example.com/more.git more-addons
ADDON_REPOS=https://framagit.org/hubzilla/addons.git addons-official
THEME_REPOS=https://github.com/saiwal/Utsukta-hub-themes.git utsukta-themes

# ==========================================
# Mail Server Settings
# ==========================================
# The email address that will appear as the sender.
SSMTP_ROOT=administrator@yourdomain.com

# The mail server to send emails through, including the port number.
SSMTP_MAILHUB=mail.example.com:587

# The username used for authentication with the mail server.
SSMTP_AUTHUSER=user@example.com

# The password used for authentication with the mail server.
SSMTP_AUTHPASS=smtp_password

# Whether to use STARTTLS for secure email transmission (Yes/No).
SSMTP_USESTARTTLS=Yes

# Whether to override the 'From' line with the root address (Yes/No).
SSMTP_FROMLINEOVERRIDE=NO

# Email alias settings for the root user and www-data user.
REVALIASES_ROOT=user@example.com:mail.example.com:587
REVALIASES_WWWDATA=user@example.com:mail.example.com:587

# ==========================================
# Database Settings
# ==========================================
# The root password for the database server.
ROOT_PASSWORD=rootpassword

# The hostname of the database service (typically 'db' for Docker).
DB_HOST=db

# The username for accessing the database.
DB_USER=hubzilla

# The password for the database user.
DB_PASS=hubzilla_password

# The name of the database to use.
DB_NAME=hubzilla

